{
  "name": "rigoutech-website",
  "version": "1.0.0",
  "private": true,
  "description": "Rigoutech static website",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js && npm run lint:claims && npm run lint:projets && npm run format:check",
    "lint:projets": "node scripts/check-projets.js",
    "projets": "node scripts/render-projets.js",
    "lint:html": "html-validate \"*.html\" \"facturx/index.html\"",
    "lint:claims": "node scripts/check-claims.js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint:js": "eslint \"assets/js/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md,yml,yaml,xml}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "html-validate": "^9.2.1",
    "prettier": "^3.4.2",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0"
  }
}
